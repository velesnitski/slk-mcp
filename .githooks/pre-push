#!/usr/bin/env bash
#
# pre-push: refuse to publish anything the sweep flags.
#
# This repository is PUBLIC and its deny-list is not (ADR 076), so the
# full scan cannot run in CI without shipping the list to a third-party
# runner — which would publish, one workflow mistake later, exactly the
# strings the list exists to protect (ADR 083). The full scan therefore
# lives here, on the machine that already holds the list.
#
# SCOPE: the working tree plus THE COMMITS BEING PUSHED — not all of
# history. Git hands us that range on stdin, and it is the only question
# a pre-push check can honestly answer. Scanning everything ever
# published turns any pre-existing hit into a permanent block: refusing
# today's push cannot un-publish a string that went out a year ago, so
# the only exits become --no-verify or a weaker deny-list, and both are
# worse than the leak (ADR 085). `make sweep-history` still audits the
# whole object store — the right scope before publishing a repo or
# after a rewrite.
#
# Install once:  make hooks
# Deliberate override:  git push --no-verify   (visible in your shell
# history; there is no quiet env-var escape on purpose)

set -uo pipefail

repo_root="$(git rev-parse --show-toplevel)" || exit 1
cd "$repo_root" || exit 1

if [[ ! -x scripts/sweep.sh ]]; then
  echo "pre-push: scripts/sweep.sh missing or not executable — refusing to push blind." >&2
  exit 1
fi

ZERO=0000000000000000000000000000000000000000

# Build the rev-range from what git is actually sending. A branch with no
# counterpart on the remote has no "before", so bound it by every other
# remote ref rather than walking back to the project's first commit.
ranges=()
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [[ -z "${local_sha:-}" || "$local_sha" == "$ZERO" ]] && continue   # branch deletion
  if [[ "${remote_sha:-$ZERO}" == "$ZERO" ]]; then
    ranges+=("$local_sha" --not --remotes)
  else
    ranges+=("$remote_sha..$local_sha")
  fi
done

if (( ${#ranges[@]} == 0 )); then
  echo "pre-push: nothing new to publish; sweeping the tree only." >&2
  ./scripts/sweep.sh
else
  echo "pre-push: sweeping tree + commits being pushed…" >&2
  ./scripts/sweep.sh --range "${ranges[*]}"
fi
status=$?

case $status in
  0) exit 0 ;;
  2)
    echo >&2
    echo "pre-push: the sweep is not configured, so it cannot clear this push." >&2
    echo "  cp .sweep-patterns.example .sweep-patterns.local  and fill it in." >&2
    echo "  The file is gitignored by design — see ADR 076." >&2
    exit 1
    ;;
  *)
    echo >&2
    echo "pre-push: sweep found something in what you are about to publish. Push blocked." >&2
    echo "  Fix the finding, or override deliberately with: git push --no-verify" >&2
    exit 1
    ;;
esac
